{
	chapter.03BC7E4965A934A5.chapter_subtitle: [
		"Any mob can become a pawn with the Tokenizer Wand."
	]
	chapter.03BC7E4965A934A5.title: "Pawns"
	chapter.082A487049C9D78A.chapter_subtitle: [
		"Little flying star creatures, and the 16 star fragments they leave behind."
	]
	chapter.082A487049C9D78A.title: "Mulas and Stars"
	chapter.0EECA9B86DA7992A.chapter_subtitle: [
		"Engrave custom dice, and give the Mulas a home."
	]
	chapter.0EECA9B86DA7992A.title: "Dice Forge"
	chapter.1D02C1C8CA264695.chapter_subtitle: [
		"Soap bubbles you can ride and steer, and the Spawn Bubbles of the board."
	]
	chapter.1D02C1C8CA264695.title: "Bubbles"
	chapter.1E0F7E79363BE53E.chapter_subtitle: [
		"Little candle ghosts of the caves: thieves of shiny things, then lamps that follow you."
	]
	chapter.1E0F7E79363BE53E.title: "Wicklings"
	chapter.20802D17BC960CF2.chapter_subtitle: [
		"The big black cat of bad luck, and the sentences of its loaded die."
	]
	chapter.20802D17BC960CF2.title: "Mistigri"
	chapter.27D1C0A527E638AD.chapter_subtitle: [
		"The Party Controller runs turns, mini-games and prizes."
	]
	chapter.27D1C0A527E638AD.title: "Running a Party"
	chapter.29E775242F126236.chapter_subtitle: [
		"Roll, move, and engrave your own faces."
	]
	chapter.29E775242F126236.title: "Dice"
	chapter.2B6392D48560B907.chapter_subtitle: [
		"Travel pipes: go in one mouth, come out of another."
	]
	chapter.2B6392D48560B907.title: "Pipes"
	chapter.3048A323DF8AC856.chapter_subtitle: [
		"Cut a 16x16 pattern, then paint or engrave it everywhere."
	]
	chapter.3048A323DF8AC856.title: "Signs and Stencils"
	chapter.3243C179234B96AF.chapter_subtitle: [
		"A few more toys for your party world."
	]
	chapter.3243C179234B96AF.title: "Odds and Ends"
	chapter.386B56372B494AA4.chapter_subtitle: [
		"A villager hidden in a box sells the offers of your stalls."
	]
	chapter.386B56372B494AA4.title: "Shops"
	chapter.3C301572B4DB69D9.chapter_subtitle: [
		"Forest birds that love shiny things, their nests, and the Common Pot they guard."
	]
	chapter.3C301572B4DB69D9.title: "Magpies"
	chapter.3DFE53E2B3C777E3.chapter_subtitle: [
		"A huge three-headed Nether tortoise with a lava tank on its back."
	]
	chapter.3DFE53E2B3C777E3.title: "Tricauldrons"
	chapter.4D82FDE861677663.chapter_subtitle: [
		"Pages, pipes, podiums and arenas: design your own mini-games."
	]
	chapter.4D82FDE861677663.title: "Mini-games"
	chapter.5136274B67A19584.chapter_subtitle: [
		"Build a board game in Minecraft, and play it with your friends."
	]
	chapter.5136274B67A19584.title: "Welcome"
	chapter.523ED47A069318CD.chapter_subtitle: [
		"A grumpy living minecart loaded with TNT or fireworks."
	]
	chapter.523ED47A069318CD.title: "Boomcarts"
	chapter.5BC7CD484E8C4C6D.chapter_subtitle: [
		"Cartridges, tiles and the Tile Linker Brush: build the path your pawns will walk."
	]
	chapter.5BC7CD484E8C4C6D.title: "The Board"
	chapter.69138B1BDF728BC8.chapter_subtitle: [
		"Toy-like blocks in 16 colours that float."
	]
	chapter.69138B1BDF728BC8.title: "Plastic"
	chapter.6CAC87F451708F44.chapter_subtitle: [
		"Grumpy acorns that shove, stack into towers and go squeak."
	]
	chapter.6CAC87F451708F44.title: "Slackorns"
	chapter.6D6E3AE0E24B2C6E.chapter_subtitle: [
		"Jump to the top, score, and watch the flag come down."
	]
	chapter.6D6E3AE0E24B2C6E.title: "Finish Pole"
	chapter.7F034F1578D84F43.chapter_subtitle: [
		"Polished terracotta and concrete, bevelled bricks and checkerboard tiles."
	]
	chapter.7F034F1578D84F43.title: "Building Blocks"
	chapter_group.10335C0348F8FC8A.title: "Commerce"
	chapter_group.60AFE736E3EC9353.title: "Stars"
	chapter_group.64160321E5CDD4E4.title: "Decoration"
	chapter_group.7821141F991152DB.title: "The Board Game"
	chapter_group.7AE3C601DC58F421.title: "Creatures"
	file.0000000000000001.title: "Steve Party Maker"
	quest.0043BA5760434BEE.quest_desc: [
		"During a party, the turn strip, announcements and scoreboard appear on screen. Press M (or /partyhud) to move them, H to hide them."
	]
	quest.0043BA5760434BEE.title: "Arrange the HUD"
	quest.007DDEF3BCF692E9.quest_desc: [
		"A Blank Die Face in a cross of 4 gold nuggets: a Blank Die Module, the base of every module."
	]
	quest.007DDEF3BCF692E9.quest_subtitle: "Craft it (owned ones don't count)"
	quest.007DDEF3BCF692E9.title: "Blank Die Module"
	quest.01961EB8EB0F1B32.quest_desc: [
		"Reach the star and buy it ([Buy] in the chat): the price goes to the storage, a star comes out of it for you."
		"The Mula throws it to you; the star may move on to another Star space."
	]
	quest.01961EB8EB0F1B32.title: "Catch a star!"
	quest.01A45DFBA3953647.quest_desc: [
		"Gains tab, above the columns: the item used as Coin and as Star. Click with any item to use it instead (nothing is taken), empty hand for the default."
		"Messages and menus then name your items: \"5 × Gold Nugget\"."
	]
	quest.01A45DFBA3953647.title: "Your own currency"
	quest.01C543D5464F2458.quest_desc: [
		"A purple plastic stud + paper + redstone: 4 cards."
		"Plays the cards since the last Sequence Start again, as many times as cards in its stack."
		"Program tab: 24 slots, read left to right."
	]
	quest.01C543D5464F2458.quest_subtitle: "Craft it (owned ones don't count)"
	quest.01C543D5464F2458.title: "Party Card: Repeat"
	quest.02559E197888FCA2.quest_desc: [
		"Mix star fragments like dyes: red + blue + yellow. You get back as many fragments as you put in."
	]
	quest.02559E197888FCA2.quest_subtitle: "Craft it (owned ones don't count)"
	quest.02559E197888FCA2.title: "White Star Fragment"
	quest.030135F1CA2F65E1.quest_desc: [
		"Right-click: pick a moment (party start, turn start, die rolled, mini-game end...). It pulses then, and a comparator reads a value (die result, rank...)."
		"Wait mode (Wrench): the party freezes until the bell gets a signal."
	]
	quest.030135F1CA2F65E1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.030135F1CA2F65E1.title: "Party Bell"
	quest.042DD30AE9744165.quest_desc: [
		"Your mini-games are written, linked and tested. Let the roulette spin!"
	]
	quest.042DD30AE9744165.title: "Game designer"
	quest.04AA8B34045AEB8D.quest_desc: [
		"Cartridge + Party Star. At the start of a party, the star lands on one Star space, under a golden beam, with a Mula playing with it."
		"Its menu: the price (20 Coins by default), sold on landing or in passing."
	]
	quest.04AA8B34045AEB8D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.04AA8B34045AEB8D.title: "Star Cartridge"
	quest.04C5B29930D85A91.quest_desc: [
		"On an Advance / Back space, a Boomcart hologram rolls out (from the space's Spawn Bubble, if linked): forward, it blasts the pawn ahead; back, it rams it."
		"Only a show: nothing broken, nobody hurt."
	]
	quest.04C5B29930D85A91.title: "Advance or back"
	quest.04F1186B64C11C43.quest_desc: [
		"A Blank Die Module ringed with 7 yellow star fragments, a tripwire hook on top."
		"During this move the pawn ignores Stop spaces and shop stops."
	]
	quest.04F1186B64C11C43.quest_subtitle: "Craft it (owned ones don't count)"
	quest.04F1186B64C11C43.title: "Die Module: Skeleton Key"
	quest.0530BAFFB80A6149.quest_desc: [
		"Place the Villager Block on the block to imitate, then fall on it from high enough (12 blocks on dirt or hay, 16 on stone, 30 on iron): a Boxed Trader disguised as that block."
		"Tick once you have one."
	]
	quest.0530BAFFB80A6149.title: "The fall"
	quest.0582B9C6A4DD1764.quest_desc: [
		"Two polished terracotta blocks of different colours as a checkerboard in a 2x2 grid: 4 tiles, each face a 2x2 checkerboard. Swap the colours for the shifted checkerboard."
	]
	quest.0582B9C6A4DD1764.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0582B9C6A4DD1764.title: "Polished Terracotta Tiles"
	quest.05A3BC086CC7390E.quest_desc: [
		"4 polished blocks in a square: 4 bevelled bricks. Each brick has its own shade, and big walls never repeat."
	]
	quest.05A3BC086CC7390E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.05A3BC086CC7390E.title: "Polished Orange Terracotta Bricks"
	quest.05F0B762268E85CD.quest_desc: [
		"4 white plastic slabs, a heavy pressure plate and a cartridge: a Tile holding that cartridge."
		"One tile = one step. It goes in 8 directions, on slabs, carpets and even stairs."
	]
	quest.05F0B762268E85CD.quest_subtitle: "Craft it (owned ones don't count)"
	quest.05F0B762268E85CD.title: "Tile"
	quest.06ACFD0AAF8EF257.quest_desc: [
		"Page + paper (or the Copy button): a linked copy, edit one and they all change. Handy for pipes and podiums far apart."
	]
	quest.06ACFD0AAF8EF257.title: "Linked copies"
	quest.06ED662D95913D40.quest_desc: [
		"Hold right-click and sweep the tiles in walking order: each one links to the next."
		"Paint a link again to erase it. Left-click: the brush's wheel (undo, redo, link modes)."
	]
	quest.06ED662D95913D40.title: "Paint the path"
	quest.07380C5346B9F4F8.quest_desc: [
		"Stonecutter: a blank face becomes any number from 0 to 10. Any face goes back to blank the same way."
	]
	quest.07380C5346B9F4F8.title: "Die Face 6"
	quest.07635CE1A88BD949.quest_desc: [
		"4 orange terracotta in a square: 4 polished blocks (17 colours for terracotta, 16 for concrete). The stonecutter makes every shape from the vanilla block directly."
	]
	quest.07635CE1A88BD949.quest_subtitle: "Craft it (owned ones don't count)"
	quest.07635CE1A88BD949.title: "Polished Orange Terracotta"
	quest.07EC74793C559519.quest_desc: [
		"Bad luck summoned, tamed and turned into a board game."
	]
	quest.07EC74793C559519.title: "Black cat"
	quest.081AE2BEE25879DB.quest_desc: [
		"Mix star fragments like dyes: red + yellow. You get back as many fragments as you put in."
	]
	quest.081AE2BEE25879DB.quest_subtitle: "Craft it (owned ones don't count)"
	quest.081AE2BEE25879DB.title: "Orange Star Fragment"
	quest.08D5A8D740C540DC.quest_desc: [
		"Mix star fragments like dyes: blue + white. You get back as many fragments as you put in."
	]
	quest.08D5A8D740C540DC.quest_subtitle: "Craft it (owned ones don't count)"
	quest.08D5A8D740C540DC.title: "Light Blue Star Fragment"
	quest.09204066F2CD4A79.quest_desc: [
		"1 gold nugget = 1 Coin. The default currency of a party: mini-games pay Coins, shops sell for them."
	]
	quest.09204066F2CD4A79.quest_subtitle: "Craft it (owned ones don't count)"
	quest.09204066F2CD4A79.title: "Coin"
	quest.09C8D40C342871A4.quest_desc: [
		"Write your own party, for example: Sequence Start, Turns, Repeat x3, Sequence Start, Mini-game, Repeat x2."
		"No cards: the number of rounds set in Settings."
	]
	quest.09C8D40C342871A4.title: "Write a program"
	quest.0A07E78ECC5CEBD1.quest_desc: [
		"A glow ink sac on a painted pattern makes it shine at night; a dry sponge turns it off."
	]
	quest.0A07E78ECC5CEBD1.title: "Glow in the dark"
	quest.0A6FCAD1E1458EE5.quest_desc: [
		"Each head charges, then spits scalding steam up to 30 blocks. Its aim freezes just before: step aside, or raise a shield towards it."
		"Each jet costs it a bucket of lava."
	]
	quest.0A6FCAD1E1458EE5.title: "Raise your shield"
	quest.0AFB2E5299CBC290.quest_desc: [
		"In their forests, a nest sometimes tops a tree: often empty, sometimes with a few nuggets or Coins, home to 1 to 3 magpies."
	]
	quest.0AFB2E5299CBC290.title: "Nest hunting"
	quest.0B48C321AB91B3F5.quest_desc: [
		"Mulas within 16 blocks of a lit forge move in and dance around the core, in rings of up to 12. A Mula that bursts at home lands back by the forge."
	]
	quest.0B48C321AB91B3F5.title: "Mula dance hall"
	quest.0B763A1CFE251521.quest_desc: [
		"Two Default Dice, shapeless. Two linked dice: 2 to 20. Splits back into two."
	]
	quest.0B763A1CFE251521.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0B763A1CFE251521.title: "Double Dice"
	quest.0BE71A5E881EDA13.quest_desc: [
		"Flint and steel: an 8 s fuse, and it rushes at the nearest other player. Relight it to send it elsewhere (+3 s, +2, +1, then no more)."
		"Rocket load: harmless fireworks. TNT: a real explosion."
	]
	quest.0BE71A5E881EDA13.title: "Hot potato"
	quest.0BF6FB84D3C83852.quest_desc: [
		"Magpies charmed, a chick born and a pot that grows on the board."
	]
	quest.0BF6FB84D3C83852.title: "Bird watcher"
	quest.0CE8734A07EDA523.quest_desc: [
		"Gold, a heavy pressure plate, redstone and quartz blocks. Podiums record the winners: the highest column is 1st."
		"Sneak on one or right-click it to take it. Click podiums with the page to link them."
	]
	quest.0CE8734A07EDA523.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0CE8734A07EDA523.title: "Redstone Podium"
	quest.0D2D7E4E7239F684.quest_desc: [
		"\"Draw the zone\" in the editor, then click two corners (128 blocks per side at most)."
		"Restore option: each round plays apart, with an empty inventory, and the arena is rebuilt at the end."
	]
	quest.0D2D7E4E7239F684.title: "Draw the zone"
	quest.0D3B9E427A996C6C.quest_desc: [
		"Cartridge + Gate Key. A gate rises on each locked exit: going through uses up a Gate Key."
		"No key: wait, take another way, or go back to start. \"Open\": stays open a few turns, or for good."
	]
	quest.0D3B9E427A996C6C.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0D3B9E427A996C6C.title: "Key Gate Cartridge"
	quest.0D7BD49CCA0CD53D.quest_desc: [
		"3 blocks in a row: 6 slabs (or the stonecutter). Slabs, stairs and walls do not float and cut bubble columns."
	]
	quest.0D7BD49CCA0CD53D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0D7BD49CCA0CD53D.title: "Yellow Plastic Slab"
	quest.0DEA2F4B09B1E78E.quest_desc: [
		"Prismarine shards + light blue panes + chest: 4 Checkpoints."
		"Pawns float through without spending a step: free turns, forks and detours. Its role never triggers, except Stop and Shop."
	]
	quest.0DEA2F4B09B1E78E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0DEA2F4B09B1E78E.title: "Checkpoint"
	quest.0E8F42A3F191C38B.quest_desc: [
		"Cartridge + piston. The pawn stopping here moves again, 1 to 6 spaces forward (green) or back (pink), pushed by a Boomcart."
		"Sneak + scroll, cartridge in hand: count and direction."
	]
	quest.0E8F42A3F191C38B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0E8F42A3F191C38B.title: "Move Forward / Back Cartridge"
	quest.0ED330980267EDAF.quest_desc: [
		"You have the basics. Next: build a board (The Board Game), then explore the other chapters in any order."
	]
	quest.0ED330980267EDAF.title: "Ready to party"
	quest.0F50802FC9CCED0C.quest_desc: [
		"Stick, redstone and feather, in a diagonal. It paints the links between spaces and shows the board while held."
	]
	quest.0F50802FC9CCED0C.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0F50802FC9CCED0C.title: "Tile Linker Brush"
	quest.0FA4F07B394DBDE0.quest_desc: [
		"Hold Jump to charge a puff, release: the bubble blows where you look. WASD drifts it."
		"Puffs too close together stretch it until it pops. Attack or sneak to get out: you fall slowly."
	]
	quest.0FA4F07B394DBDE0.title: "Bubble pilot"
	quest.0FC0569B81622F76.quest_desc: [
		"Mix star fragments like dyes: green + white. You get back as many fragments as you put in."
	]
	quest.0FC0569B81622F76.quest_subtitle: "Craft it (owned ones don't count)"
	quest.0FC0569B81622F76.title: "Lime Star Fragment"
	quest.101F5B0C2C547670.quest_desc: [
		"A tape deck. Right-click a button on top: its mode. Previous · Replay · Next."
		"Next + a pulse: skips what the party waits for (a turn not rolled, a bell, the practice round); in a mini-game, ends it with the podiums' places."
		"Replay + a pulse: the turn is undone and played again, or the round restarts. Previous: back to the turn before."
		"Link it to any part of a game with the Tile Linker Brush; otherwise it drives the nearest party (64 blocks)."
	]
	quest.101F5B0C2C547670.quest_subtitle: "Craft it (owned ones don't count)"
	quest.101F5B0C2C547670.title: "Party Rewinder"
	quest.10373F304237AA4E.quest_desc: [
		"6 blocks in steps: 4 stairs."
	]
	quest.10373F304237AA4E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.10373F304237AA4E.title: "Polished Light Blue Concrete Stairs"
	quest.10428E9FDADB4DDF.quest_desc: [
		"A pink plastic stud + paper + redstone: 4 cards."
		"The next Repeat card starts again from here."
		"Program tab: 24 slots, read left to right."
	]
	quest.10428E9FDADB4DDF.quest_subtitle: "Craft it (owned ones don't count)"
	quest.10428E9FDADB4DDF.title: "Party Card: Sequence start"
	quest.10458D4F11AF735B.quest_desc: [
		"3 blocks in a row: 6 slabs."
	]
	quest.10458D4F11AF735B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.10458D4F11AF735B.title: "Polished Light Blue Concrete Slab"
	quest.104F2426E5EBE598.quest_desc: [
		"The controller creates nothing: put the party's Coins and Party Stars in its Storage tab (hoppers work too)."
		"Prizes, stars for sale and spaces without a chest are paid from it; what the party takes goes back there."
		"Chests linked to it with the Tile Linker Brush pay after its own slots."
	]
	quest.104F2426E5EBE598.title: "Fill the storage"
	quest.114B635016EE5B45.quest_desc: [
		"4 blocks of a colour and 2 plastic sticks: 3 fences. They connect to each other and carry road signs."
	]
	quest.114B635016EE5B45.quest_subtitle: "Craft it (owned ones don't count)"
	quest.114B635016EE5B45.title: "Orange Plastic Fence"
	quest.123B0FCCF856E8AB.quest_desc: [
		"Dropped by a blue Mula when it bursts."
	]
	quest.123B0FCCF856E8AB.title: "Blue Star Fragment"
	quest.12D10278EDD127AE.quest_desc: [
		"Two calm Slackorns that meet climb on each other, up to 5."
		"Empty hand: right-click one to carry it (with those above), right-click another to stack, left-click to throw. Hit one mid-tower: it flies off like a missile."
	]
	quest.12D10278EDD127AE.title: "Slackorn tower"
	quest.12DD5B229D31EBED.quest_desc: [
		"Two different cartridges in an Advanced Tile, then power it: role, colour and destinations follow the signal."
		"With a redstone counter, the space changes every turn."
	]
	quest.12DD5B229D31EBED.title: "A tile that changes"
	quest.12EC9CFFA8E18C18.quest_desc: [
		"Every kind of pipe, and a warp network of your own. For mini-game pipes, see the Mini-games chapter."
	]
	quest.12EC9CFFA8E18C18.title: "Plumber"
	quest.137ABC52300C1CE9.quest_desc: [
		"The ring: 1 to 12 faces (stack size = weight). The 5 fragment slots: 5 different colours (black can repeat and is never used up). Plus blank faces."
		"Click the arrow: FORGE! One die every 5 s."
	]
	quest.137ABC52300C1CE9.title: "Your own die"
	quest.13E6F42BB1F3D4AC.quest_desc: [
		"A Party Star in 4 lapis blocks (the star: see Mulas and Stars). The head of the Tokenizer Wand."
	]
	quest.13E6F42BB1F3D4AC.quest_subtitle: "Craft it (owned ones don't count)"
	quest.13E6F42BB1F3D4AC.title: "Lapis Crystal Ball"
	quest.13F7D62B117D88BF.quest_desc: [
		"A treasure enchantment for the wand: woodland mansion chests, evokers and illusioners."
		"Resize anyone's pawn and exclude any pawn from a party, like a referee."
	]
	quest.13F7D62B117D88BF.title: "Game Master"
	quest.140D4DEEA26370A8.quest_desc: [
		"Sneak + right-click your Wickling empty-handed: it sits; again: it falls asleep as a candle holder that gives light and keeps everything. Empty hand: wake it up."
		"Broken, it drops as an item: a Wickling is never lost."
	]
	quest.140D4DEEA26370A8.title: "Wickling Candle Holder"
	quest.1447F66898AC91E0.quest_desc: [
		"Mix star fragments like dyes: red + green (or orange + black). You get back as many fragments as you put in."
	]
	quest.1447F66898AC91E0.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1447F66898AC91E0.title: "Brown Star Fragment"
	quest.1569C7FE3FB27DB1.quest_desc: [
		"Put your pawn on a Start space: it binds to it and floats. Right-click the space empty-handed to own it."
		"Only bound pawns join a party."
	]
	quest.1569C7FE3FB27DB1.title: "Take your place"
	quest.1661B4C0B973F8ED.quest_desc: [
		"Crying obsidian, 4 star fragments and a heavy core."
		"Placed, it pulls everything within 8 blocks into orbit (no fall damage; full iron armour or heavier resists). It also powers the Dice Forge."
	]
	quest.1661B4C0B973F8ED.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1661B4C0B973F8ED.title: "Gravity Core"
	quest.169B6F8AE6D4D572.quest_desc: [
		"Leather boots + rabbit's foot + 2 slime balls. Chain jumps within 1.5 s: the 2nd is 1.5 times higher, the 3rd twice as high."
	]
	quest.169B6F8AE6D4D572.quest_subtitle: "Craft it (owned ones don't count)"
	quest.169B6F8AE6D4D572.title: "Triple Jump Shoes"
	quest.174373BB4245951D.quest_desc: [
		"6 bricks in steps: 4 stairs."
	]
	quest.174373BB4245951D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.174373BB4245951D.title: "Polished Orange Terracotta Brick Stairs"
	quest.186792E8E005709E.quest_desc: [
		"Outside the Bubbler's column, a bubble pops on a block, a mob, an arrow, or after 15 s still."
		"A snowball pushes it: a dispenser of snowballs is a bubble cannon. Silk Touch pushes it without popping it."
	]
	quest.186792E8E005709E.title: "Bubble cannon"
	quest.18BCF0FF3DA0DC75.quest_desc: [
		"4 plastic pellets, a water bucket and redstone (the bucket comes back)."
		"Walk onto it: a soap bubble lifts you 30 blocks (2 per redstone level), then floats. Sneak to cross it. Mobs and items get bubbled too."
	]
	quest.18BCF0FF3DA0DC75.quest_subtitle: "Craft it (owned ones don't count)"
	quest.18BCF0FF3DA0DC75.title: "Bubbler"
	quest.18EC779BAD8C3C13.quest_desc: [
		"Stonecutter: 1 Tile = 2 small tiles (1x1); 2 small ones = 1 Tile again at the crafting table."
		"4 Tiles in a 2x2 square: 1 large tile (2x2 blocks)."
	]
	quest.18EC779BAD8C3C13.title: "Small and large tiles"
	quest.19A1A7E217DE13A3.quest_desc: [
		"The little extras of the mod, all found."
	]
	quest.19A1A7E217DE13A3.title: "Odds and ends"
	quest.19A853BEFF159A68.quest_desc: [
		"Every plastic shape, and blocks that float and vanish on cue."
	]
	quest.19A853BEFF159A68.title: "Toy box"
	quest.19AA36BD5464D0A3.quest_desc: [
		"Dropped by a red Mula when it bursts."
	]
	quest.19AA36BD5464D0A3.title: "Red Star Fragment"
	quest.19DDB0C5335E0D86.quest_desc: [
		"A Cartridge in 4 paper: 4 Mini-Game Pages. A page IS a mini-game: title, rules, image, formats, pipes, results and zone."
	]
	quest.19DDB0C5335E0D86.quest_subtitle: "Craft it (owned ones don't count)"
	quest.19DDB0C5335E0D86.title: "Mini-Game Page"
	quest.1AE45F8A8581A1AD.quest_desc: [
		"Fed, lit, passed around, and booming on the board."
	]
	quest.1AE45F8A8581A1AD.title: "Demolition crew"
	quest.1BEF46FC4ACE5F48.quest_desc: [
		"6 plastic blocks of the colour in two columns: 6 pipes. Linked to a page, a pipe of this colour has the role \"Exit\"."
	]
	quest.1BEF46FC4ACE5F48.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1BEF46FC4ACE5F48.title: "Yellow Pipe: Exit"
	quest.1C32C1531E31974E.quest_desc: [
		"Hits do nothing. Jump on its cap: squeak! The second squash finishes it (the third for a mossy one): 1 or 2 acorns."
		"Bone meal on a Slackorn can also give one, once a minute at most."
	]
	quest.1C32C1531E31974E.title: "Acorn"
	quest.1DDCEBDE63F41C2D.quest_desc: [
		"Cartridge + the Mistigri's Die (its loot)."
		"In a party, the pawn stopping here brings out the Mistigri: it juggles its loaded die, the whole party watches a roulette of sentences, then one falls."
	]
	quest.1DDCEBDE63F41C2D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1DDCEBDE63F41C2D.title: "Mistigri Cartridge"
	quest.1E5F2B0FBCFDA39D.quest_desc: [
		"Blank face + ender pearl. The roller's pawn swaps places with another player's pawn of their choice."
	]
	quest.1E5F2B0FBCFDA39D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1E5F2B0FBCFDA39D.title: "Swap Die Face"
	quest.1E702253EDB71ED3.quest_desc: [
		"4 polished blocks in a square: 4 bevelled bricks. Each brick has its own shade, and big walls never repeat."
	]
	quest.1E702253EDB71ED3.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1E702253EDB71ED3.title: "Polished Light Blue Concrete Bricks"
	quest.1EE3A5D49F8077F1.quest_desc: [
		"6 plastic blocks of the colour in two columns: 6 pipes. Linked to a page, a pipe of this colour has the role \"Team A\"."
	]
	quest.1EE3A5D49F8077F1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1EE3A5D49F8077F1.title: "Blue Pipe: Team A"
	quest.1F2DCDEC85464F26.quest_desc: [
		"Build a board game in Minecraft and play it with friends: tiles, pawns, dice, mini-games and stars."
		""
		"One quest per item, a big milestone at the end of each chapter. Tick this quest to start!"
	]
	quest.1F2DCDEC85464F26.quest_subtitle: "A party game, block by block"
	quest.1F2DCDEC85464F26.title: "Welcome to Steve Party Maker!"
	quest.1FAB526747142277.quest_desc: [
		"A Podium + an iron ingot, shapeless. Only a look: the height of the column decides the place."
	]
	quest.1FAB526747142277.quest_subtitle: "Craft it (owned ones don't count)"
	quest.1FAB526747142277.title: "Iron Podium"
	quest.1FD5DF613F9840F0.quest_desc: [
		"Put an Inventory Cartridge linked to a chest in it (Wrench), hang it with 2 or 3 blocks of air below, then jump and hit it with your head: it drops the chest's items."
		"2 hits, then 3 s to recharge."
	]
	quest.1FD5DF613F9840F0.title: "Bonk!"
	quest.203C683BC60BB2EA.quest_desc: [
		"Gold ingots, polished terracotta, a chest and an amethyst shard."
	]
	quest.203C683BC60BB2EA.quest_subtitle: "Craft it (owned ones don't count)"
	quest.203C683BC60BB2EA.title: "Looting Box"
	quest.2059FF1EE20FE13D.quest_desc: [
		"Teams (2 to 4 sides, \"1 vs all\", \"2 vs 2\"...), free-for-all or all together. A page is drawn only if one of its formats fits the board's teams."
		"Team A: players on positive spaces. Team B: on negative ones."
	]
	quest.2059FF1EE20FE13D.title: "Formats"
	quest.209EEA42C80532A7.quest_desc: [
		"Two rows of 3: 6 walls."
	]
	quest.209EEA42C80532A7.quest_subtitle: "Craft it (owned ones don't count)"
	quest.209EEA42C80532A7.title: "Polished Orange Terracotta Brick Wall"
	quest.2107B23BC93CF590.quest_desc: [
		"6 plastic blocks of the colour in two columns: 6 pipes. Linked to a page, a pipe of this colour has the role \"Team B\". Purple and orange pipes are teams C and D."
	]
	quest.2107B23BC93CF590.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2107B23BC93CF590.title: "Red Pipe: Team B"
	quest.226EA47348D44FE3.quest_desc: [
		"A Blank Die Module ringed with 7 purple star fragments, an echo shard on top."
		"The die becomes a power-up: used once, in place of your roll (every other die comes back to its roller)."
	]
	quest.226EA47348D44FE3.quest_subtitle: "Craft it (owned ones don't count)"
	quest.226EA47348D44FE3.title: "Power-up Module"
	quest.2275C38C50DEE4C0.quest_desc: [
		"Mix star fragments like dyes: gray + white. You get back as many fragments as you put in."
	]
	quest.2275C38C50DEE4C0.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2275C38C50DEE4C0.title: "Light Gray Star Fragment"
	quest.23960C8EFFCAEE1A.quest_desc: [
		"The base can count a scoreboard criterion instead: jumps, deaths, kills... For example 10 jumps, goal per player, podiums by the base."
	]
	quest.23960C8EFFCAEE1A.title: "Count anything"
	quest.23B52C759DD360F3.quest_desc: [
		"6 glass: 6 clear pipes. Linked to a mini-game page, a glass pipe is for spectators."
	]
	quest.23B52C759DD360F3.quest_subtitle: "Craft it (owned ones don't count)"
	quest.23B52C759DD360F3.title: "Glass Pipe"
	quest.24109299821DBF96.quest_desc: [
		"Mix star fragments like dyes: red + white. You get back as many fragments as you put in."
	]
	quest.24109299821DBF96.quest_subtitle: "Craft it (owned ones don't count)"
	quest.24109299821DBF96.title: "Pink Star Fragment"
	quest.2512D1E030566DA6.quest_desc: [
		"Dropped by a green Mula when it bursts."
	]
	quest.2512D1E030566DA6.title: "Green Star Fragment"
	quest.257DAAA6F776BD7D.quest_desc: [
		"One blue (bonus) and one red (malus) space. In a party, the colour under each pawn makes the mini-game teams."
	]
	quest.257DAAA6F776BD7D.title: "Bonus and malus"
	quest.258F95E4E3F8CB04.quest_desc: [
		"Right-click it with TNT or a firework rocket: it swallows the new load and spits out the old one. Loaded by a player, it never despawns."
	]
	quest.258F95E4E3F8CB04.title: "Feed it"
	quest.25F6A5B53D501ECE.quest_desc: [
		"A piston pushing down on an adult villager's head squashes it into a block, alive inside (about 70 reactions)."
		"Break it by hand (it begs) to pick it up; a sticky piston lets it out."
	]
	quest.25F6A5B53D501ECE.title: "Villager Block"
	quest.263C5F0A947E29AD.quest_desc: [
		"Inventory Cartridge + lava bucket (the bucket comes back)."
		"In a party, the pawn stopping here brings out a Tricauldron, one head per prize (1 to 5), from the linked chests or the storage. The player hits a head, blind by default: it spits its prize."
	]
	quest.263C5F0A947E29AD.quest_subtitle: "Craft it (owned ones don't count)"
	quest.263C5F0A947E29AD.title: "Tricauldron Cartridge"
	quest.267711A12D93A0B2.quest_desc: [
		"2 yellow plastic slabs, a light pressure plate, a trapped chest and 2 cartridges."
		"It holds 16 cartridges: the redstone power picks the active one (0 = slot 1, 1 = slot 2...)."
	]
	quest.267711A12D93A0B2.quest_subtitle: "Craft it (owned ones don't count)"
	quest.267711A12D93A0B2.title: "Advanced Tile"
	quest.26EF608BF2CC42FA.quest_desc: [
		"Right-click: the die flies over the nearest mob (sneak: the nearest player) and spins. Hit it to stop it."
	]
	quest.26EF608BF2CC42FA.title: "Roll it!"
	quest.272DDEDA8986AF7E.quest_desc: [
		"In a party, a mini-game with its controller starts with a practice round, for nothing."
		"Press Y (or Ready) when you are; once everyone is, the real round starts and pays."
	]
	quest.272DDEDA8986AF7E.title: "Ready? Press Y"
	quest.27772ED003E3C5B6.quest_desc: [
		"Every sign, your own patterns and the Stencil Hammer."
	]
	quest.27772ED003E3C5B6.title: "Sign painter"
	quest.27B5092765B1742F.quest_desc: [
		"A lime plastic stud + paper + redstone: 4 cards."
		"One mini-game from the catalogue."
		"Program tab: 24 slots, read left to right."
	]
	quest.27B5092765B1742F.quest_subtitle: "Craft it (owned ones don't count)"
	quest.27B5092765B1742F.title: "Party Card: Mini-game"
	quest.27E0EE1DE702627E.quest_desc: [
		"Three Default Dice, or a Double + a Default Die. Three linked dice: 3 to 30."
	]
	quest.27E0EE1DE702627E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.27E0EE1DE702627E.title: "Triple Dice"
	quest.280705EA919A80DA.quest_desc: [
		"A ceramic pig with an Inventory Cartridge. Each pulse gives (or takes) its items: player of the turn, mini-game winners, everyone or the nearest."
		"All-or-nothing mode: sell a Party Star for Coins."
	]
	quest.280705EA919A80DA.quest_subtitle: "Craft it (owned ones don't count)"
	quest.280705EA919A80DA.title: "Piggy Bank"
	quest.2843C6B391C3BB10.quest_desc: [
		"Cartridge + Magpie Nest. A straw-coloured Common Pot space."
		"Click a Magpie Nest with the cartridge (or paint from the space to it with the Tile Linker Brush): that nest IS the pot."
	]
	quest.2843C6B391C3BB10.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2843C6B391C3BB10.title: "Common Pot Cartridge"
	quest.29342BD8BA7FCED5.quest_desc: [
		"Squashed, planted, stacked and put on the board."
	]
	quest.29342BD8BA7FCED5.title: "Acorn keeper"
	quest.2AB220E13F0C50C3.quest_desc: [
		"Throw an acorn within 12 blocks of it: it forgets everything, even its anger, and plays with it for 30 s to a minute."
	]
	quest.2AB220E13F0C50C3.title: "Ball of yarn"
	quest.2ABA40709E3044BA.quest_desc: [
		"Paper, glass, redstone torch, gold ingots, any mini-game pipe and iron ingots. In the arena, it holds the mini-game's page."
		"Lamp: red (idle), orange (practice round), green (playing). A comparator reads it."
	]
	quest.2ABA40709E3044BA.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2ABA40709E3044BA.title: "Mini-game Controller"
	quest.2B3995C665E08E2E.quest_desc: [
		"You can run a whole party, and drive it with redstone."
	]
	quest.2B3995C665E08E2E.title: "Party host"
	quest.2B5EA72645901420.quest_desc: [
		"Two occupied bubbles that touch merge (8 passengers at most). Everyone steers: opposite pushes cancel out."
	]
	quest.2B5EA72645901420.title: "Two in a bubble"
	quest.2BAA43480CA56926.quest_desc: [
		"A gold ingot over two iron bars, in a column. Stack as many segments as you like on the base."
	]
	quest.2BAA43480CA56926.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2BAA43480CA56926.title: "Goal Pole"
	quest.2BD1848C751D2C08.quest_desc: [
		"Lapis crystal ball, gold block and blaze rod, in a column. A golden wand with a lapis orb."
	]
	quest.2BD1848C751D2C08.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2BD1848C751D2C08.title: "Tokenizer Wand"
	quest.2CC4E00732BE3C9B.quest_desc: [
		"Book and quill + map + clock + the \"otherside\" disc. Holds 91 pages. In the Party Controller, the roulette draws its mini-games."
	]
	quest.2CC4E00732BE3C9B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2CC4E00732BE3C9B.title: "Mini Games Catalogue"
	quest.2CE0BF8C6935F2C0.quest_desc: [
		"3 sticks + 1 feather (magpies drop feathers). 27 slots of up to 256 Coins or shiny items each."
		"Right-click: put the stack in (sneak: one); empty hand: take the last one back. Hoppers and comparators work."
	]
	quest.2CE0BF8C6935F2C0.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2CE0BF8C6935F2C0.title: "Magpie Nest"
	quest.2D64151C55086784.quest_desc: [
		"You have built, played and collected everything Steve Party Maker has to offer. Thank you for playing the beta!"
	]
	quest.2D64151C55086784.quest_subtitle: "Every chapter complete"
	quest.2D64151C55086784.title: "Steve Party Master"
	quest.2E1EFBCB9519EEE1.quest_desc: [
		"6 plastic blocks of one colour in two columns: 6 pipes (16 colours). A pipe placed against another (or before its mouth) connects to it."
	]
	quest.2E1EFBCB9519EEE1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2E1EFBCB9519EEE1.title: "Lime Pipe"
	quest.2E754E69CDD7EF1A.quest_desc: [
		"Cartridge + chest. It links up to 8 chests (right-click them) and gives or takes their items."
		"Positive items: bonus space (blue). Negative: malus (red). None: item space (orange)."
		"No chest, in a party: the Party Controller's storage."
	]
	quest.2E754E69CDD7EF1A.quest_subtitle: "Craft it (owned ones don't count)"
	quest.2E754E69CDD7EF1A.title: "Inventory Cartridge"
	quest.2EE9B60E92035305.quest_desc: [
		"Saddle it in its screen. Up to 3 riders, one head each: everyone's keys add up."
		"Lava is its fuel (lava bucket while riding). Click: your head spits. Hold Jump: a steam leap."
	]
	quest.2EE9B60E92035305.title: "Three riders"
	quest.2EF12416B1262A81.quest_desc: [
		"Right-click a mob with the wand (or shoot it a spark), then draw a circle around it: on the guide, a 1-block pawn; from 0.25 to 2 blocks."
		"It becomes your still, silent, invulnerable figurine."
	]
	quest.2EF12416B1262A81.title: "Pionificus!"
	quest.2F3A30222BF08C93.quest_desc: [
		"Break a tile with Silk Touch: one item that keeps its cartridges, their settings and its look."
	]
	quest.2F3A30222BF08C93.title: "Pack a tile"
	quest.2F86298582A1E025.quest_desc: [
		"Dice, special faces and modules: every roll can now be a surprise."
	]
	quest.2F86298582A1E025.title: "Dice collector"
	quest.3015D9B1FF57C11A.quest_desc: [
		"A Blank Die Module ringed with 7 red star fragments, a fermented spider eye on top."
		"A negative module: the pawn moves back, and Coins won are lost."
	]
	quest.3015D9B1FF57C11A.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3015D9B1FF57C11A.title: "Die Module: Reversed"
	quest.308B809C31445486.quest_desc: [
		"3 bricks in a row: 6 slabs."
	]
	quest.308B809C31445486.quest_subtitle: "Craft it (owned ones don't count)"
	quest.308B809C31445486.title: "Polished Orange Terracotta Brick Slab"
	quest.30B76A9DDAC3BA6B.quest_desc: [
		"At dusk, a full moon has a 25% chance of an Ephemeride: 6 waves of shooting stars, then 3 to 5 Mulas land where they went."
		"A Dice Forge at max level brings one every full moon."
	]
	quest.30B76A9DDAC3BA6B.title: "Shooting-star night"
	quest.30E06C6BD698E571.quest_desc: [
		"9 fragments of one colour: a glowing block of animated plasma (black: a starry night). It attracts curious Mulas."
	]
	quest.30E06C6BD698E571.quest_subtitle: "Craft it (owned ones don't count)"
	quest.30E06C6BD698E571.title: "Block of Blue Star Fragments"
	quest.33F2B84D658F752B.quest_desc: [
		"Inventory Cartridge + a bandana stolen from a Boxed Trader (see Shops)."
		"A pawn stopping here (or passing a Checkpoint with it) brings out a Boxed Trader. Up to 9 offers, set in the cartridge's stall; the goods come from its chests, else the Party Controller's storage."
	]
	quest.33F2B84D658F752B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.33F2B84D658F752B.title: "Shop Cartridge"
	quest.345F2775C4F5745A.quest_desc: [
		"Stone buttons, gold, chest and iron. Payments land in the linked registers; each sale sends a redstone pulse."
	]
	quest.345F2775C4F5745A.quest_subtitle: "Craft it (owned ones don't count)"
	quest.345F2775C4F5745A.title: "Cash register"
	quest.346595A5E4D15B1C.quest_desc: [
		"9 identical planks: 2 big wooden boards, on a post, hanging or flat."
	]
	quest.346595A5E4D15B1C.quest_subtitle: "Craft it (owned ones don't count)"
	quest.346595A5E4D15B1C.title: "Wooden Panel"
	quest.3476803BD17DBC9E.quest_desc: [
		"A orange plastic stud + paper + redstone: 4 cards."
		"Rings the Party Bells set to Event; the channel is the stack size."
		"Program tab: 24 slots, read left to right."
	]
	quest.3476803BD17DBC9E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3476803BD17DBC9E.title: "Party Card: Event"
	quest.35120B4602A51333.quest_desc: [
		"Two rows of 3: 6 walls."
	]
	quest.35120B4602A51333.quest_subtitle: "Craft it (owned ones don't count)"
	quest.35120B4602A51333.title: "Polished Orange Terracotta Wall"
	quest.35237C08B4821CCD.quest_desc: [
		"Hoppers on top and sides fill it, a hopper below takes the dice out. With redstone power it restarts by itself once restocked."
	]
	quest.35237C08B4821CCD.title: "Dice factory"
	quest.3619C77AF2064C99.quest_desc: [
		"Dropped by a yellow Mula when it bursts."
	]
	quest.3619C77AF2064C99.title: "Yellow Star Fragment"
	quest.366E43B34F9C7D7E.quest_desc: [
		"Planks and sticks (PPP / PPP / S S): 2 easel signs, in any wood, modded ones included. Stands on the ground."
	]
	quest.366E43B34F9C7D7E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.366E43B34F9C7D7E.title: "Easel Sign"
	quest.3817AA11E5F4EFA0.quest_desc: [
		"Your finish line is ready: jump, score, win."
	]
	quest.3817AA11E5F4EFA0.title: "Goal!"
	quest.385B95560FE8A09B.quest_desc: [
		"Cartridge + lime dye. A pawn placed on it binds to it, floats and takes its colour."
		"The Party Controller only takes pawns bound to a start space."
	]
	quest.385B95560FE8A09B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.385B95560FE8A09B.title: "Start Cartridge"
	quest.38DC8F88EE22AE2C.quest_desc: [
		"A pipe that ends in a solid block warps you to the nearest mouth of its colour within 100 blocks (opaque and windowed count as one colour)."
	]
	quest.38DC8F88EE22AE2C.title: "Warp"
	quest.3B5CBE11E9AEFBBE.quest_desc: [
		"6 plastic blocks of the colour in two columns: 6 pipes. Linked to a page, a pipe of this colour has the role \"Entry\"."
	]
	quest.3B5CBE11E9AEFBBE.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3B5CBE11E9AEFBBE.title: "Black Pipe: Entry"
	quest.3E137565F331C99C.quest_desc: [
		"6 stained glass of one colour: 6 stained glass pipes (16 colours)."
	]
	quest.3E137565F331C99C.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3E137565F331C99C.title: "Magenta Stained Glass Pipe"
	quest.3F2D0BF6F9D5D9F1.quest_desc: [
		"A Blank Die Module ringed with 7 pink star fragments, TNT on top."
		"The die explodes when it vanishes: it hurts and knocks back everyone around, roller included."
	]
	quest.3F2D0BF6F9D5D9F1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3F2D0BF6F9D5D9F1.title: "Die Module: Firecracker"
	quest.3F4EF27EE42BEC9C.quest_desc: [
		"Blank face + Coin: a +1 Coins face (stonecutter: +2 to +10). Instead of moving, the roller gets that many Coins from the storage."
	]
	quest.3F4EF27EE42BEC9C.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3F4EF27EE42BEC9C.title: "Coin Die Face +1"
	quest.3F68A81D8A5CA07D.quest_desc: [
		"Redstone torch, gold nuggets, glass pane, stone button. Sneak + click a Mini-game Controller to link it."
		"Out of a party: plays or stops that mini-game from afar. In a party: tells you're ready for the real round."
	]
	quest.3F68A81D8A5CA07D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.3F68A81D8A5CA07D.title: "Remote"
	quest.405FC7652C003313.quest_desc: [
		"Custom dice, a core at full height and Mulas dancing around it."
	]
	quest.405FC7652C003313.title: "Forgemaster"
	quest.40EEE1A3FDE98A1B.quest_desc: [
		"Walk in front of it: Bad Luck for 1 minute; hit it: 2 minutes (it gets angry, never fights)."
		"It knocks items off item frames and naps on chests, which stay shut until raw fish wakes it."
	]
	quest.40EEE1A3FDE98A1B.title: "Don't cross its path"
	quest.42057F6E6F797B1D.quest_desc: [
		"Land on top of a pole: \"+1 ♥\", a golden heart for 10 s, no fall damage, and you stand upside down. Each landing scores a point."
	]
	quest.42057F6E6F797B1D.title: "Extra Life!"
	quest.422060BE55D3D1D7.quest_desc: [
		"Empty buckets on it: 1 lava bucket each (up to 27), no anger. Only someone who drained it can tame it: mount it empty-handed."
		"It yields (70% empty, never full, +10% per failed try) or throws you off."
	]
	quest.422060BE55D3D1D7.title: "Drain and tame"
	quest.423032099703F693.quest_desc: [
		"A plastic block over plastic pellets: 2 road signs of the block's colour. The Wrench cycles the plate: round, square, diamond, triangle, star, heart. Off its post, it floats."
	]
	quest.423032099703F693.quest_subtitle: "Craft it (owned ones don't count)"
	quest.423032099703F693.title: "Plastic Road Sign"
	quest.42C4E05F055ED63B.quest_desc: [
		"A Party Star, obsidian, a blast furnace and a netherite ingot. It engraves dice with the faces and weights you choose, by hand, hoppers or redstone."
	]
	quest.42C4E05F055ED63B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.42C4E05F055ED63B.title: "Dice Forge"
	quest.42D5C0FDC568C5B3.quest_desc: [
		"Your pawn waits on its start space. Time to roll some dice!"
	]
	quest.42D5C0FDC568C5B3.title: "Pawn master"
	quest.43758D7B5C5F556E.quest_desc: [
		"Gold, a redstone torch, a chest and an amethyst shard."
		"The destinations of its cartridge are the tiles it drives: one lever switches a whole board."
		"A comparator reads its tiles: 14 bonus, 13 malus, 10 Stop, 8 Teleport, 1 a pawn passes..."
	]
	quest.43758D7B5C5F556E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.43758D7B5C5F556E.title: "Board Space Redstone router"
	quest.44A6CEA198F3D329.quest_desc: [
		"Every recipe of the mod can be read in a recipe viewer (REI or EMI) if the pack has one: it also shows every tile with its cartridge."
		"The mod's wiki (on its GitHub page) explains each block in detail."
	]
	quest.44A6CEA198F3D329.title: "Read the recipes"
	quest.44BBB28CA9222EC6.quest_desc: [
		"Right-click a pawn with a dye: its name and its base change colour (and its start space too)."
	]
	quest.44BBB28CA9222EC6.title: "Team colours"
	quest.476FD02CC564638E.quest_desc: [
		"3 blocks in a row: 6 slabs."
	]
	quest.476FD02CC564638E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.476FD02CC564638E.title: "Polished Orange Terracotta Slab"
	quest.480DEBADCC26795B.quest_desc: [
		"Cartridge + candle. In a party, the pawn stopping here brings out a Wickling: its player picks a victim, the Wickling robs them (Coins or Party Stars) and brings the loot back."
		"With the defence on, the victim has 7 s to hit it: each hit gives some back."
	]
	quest.480DEBADCC26795B.quest_subtitle: "Craft it (owned ones don't count)"
	quest.480DEBADCC26795B.title: "Wickling Cartridge"
	quest.486B21C664042E3A.quest_desc: [
		"A star fragment, a gold ingot and a gold nugget, in a column. Right-click the trader to link it (the first to link it owns it), then each block: stall, stock chests, registers."
	]
	quest.486B21C664042E3A.quest_subtitle: "Craft it (owned ones don't count)"
	quest.486B21C664042E3A.title: "Shopkeeper Key"
	quest.48EDC9CAA41959B9.quest_desc: [
		"Dropped by a purple Mula when it bursts."
	]
	quest.48EDC9CAA41959B9.title: "Purple Star Fragment"
	quest.49297133DC9D18C2.quest_desc: [
		"One fragment each of blue, green, yellow, red and purple (or 5 black ones)."
		"The default Star of a party. It also goes into the Star Cartridge, the Lapis Crystal Ball, the Dice Forge and the iron and golden mini-game pipes."
	]
	quest.49297133DC9D18C2.quest_subtitle: "Craft it (owned ones don't count)"
	quest.49297133DC9D18C2.title: "Party Star"
	quest.4973F5A913628816.quest_desc: [
		"Right-click a wild Mula with a star fragment of its colour: 1 chance in 3. Tamed, it floats above you like a balloon."
	]
	quest.4973F5A913628816.title: "Best friend"
	quest.49A1A95AD39CC7A6.quest_desc: [
		"Dye: colours the cartridge (on a Checkpoint, the whole cube)."
		"Glow ink sac: it shines. Ink sac: off. Sponge: dye removed."
	]
	quest.49A1A95AD39CC7A6.title: "Colours and glow"
	quest.49C4BD610323C14F.quest_desc: [
		"A placed Gravity Core never climbs and cannot explode: a fixed, safe attraction. Chicken carousel, item collector..."
	]
	quest.49C4BD610323C14F.title: "Merry-go-round"
	quest.4A7A5955A37DF6B0.quest_desc: [
		"Right-click a mouth, sneak in front of it, or fall in: you rush through and come out at another end of the network, at random. Mobs, pawns and items too."
	]
	quest.4A7A5955A37DF6B0.title: "Whoosh!"
	quest.4A9446B6E9669567.quest_desc: [
		"Right-click: six tabs (Status, Players, Program, Gains, Storage, Settings)."
		"Status lists what is missing before \"Start the party\" lights up; a \"!\" marks the tab to fix."
	]
	quest.4A9446B6E9669567.title: "The dashboard"
	quest.4B862393844E8C60.quest_desc: [
		"The Villager Block reacts to everything: stare at it, jump, show it emeralds, play a disc nearby... About 70 reactions to find."
	]
	quest.4B862393844E8C60.title: "Squishy friend"
	quest.4BD97BC245ABD3F0.quest_desc: [
		"Stencil in one hand, dye in the other, right-click a sign or any full block face: the pattern is painted (1 dye, the stencil stays)."
		"On a wall, only a wet sponge or a brush wipes it off."
	]
	quest.4BD97BC245ABD3F0.title: "Paint a wall"
	quest.4BE7B23596D212E5.quest_desc: [
		"All 16 colours of star fragments, and a Party Star of your own."
	]
	quest.4BE7B23596D212E5.title: "Star collector"
	quest.4C1ED42CA5A03E7A.quest_desc: [
		"Right-click one of your pawns with the wand and draw a new circle to change its size."
	]
	quest.4C1ED42CA5A03E7A.title: "Resizing spell"
	quest.4C6E654F6972F00F.quest_desc: [
		"Crafting table: a die + module items = the same die with those modules (the module items stay in the grid). Its tooltip lists them."
	]
	quest.4C6E654F6972F00F.title: "Fit a module"
	quest.4D740A8C8B416C56.quest_desc: [
		"A Blank Die Module ringed with 7 magenta star fragments, an eye of ender on top."
		"At forks the pawn chooses on its own, at random."
	]
	quest.4D740A8C8B416C56.quest_subtitle: "Craft it (owned ones don't count)"
	quest.4D740A8C8B416C56.title: "Die Module: Homing"
	quest.4DC6FEBAF30A3370.quest_desc: [
		"Your shop is open, on and off the board."
	]
	quest.4DC6FEBAF30A3370.title: "Shopkeeper"
	quest.4E3F2C32016B79DF.quest_desc: [
		"A Blank Die Module ringed with 7 orange star fragments, a wind charge on top."
		"Stop or again: after the result, keep it or roll again, once per module."
	]
	quest.4E3F2C32016B79DF.quest_subtitle: "Craft it (owned ones don't count)"
	quest.4E3F2C32016B79DF.title: "Die Module: Reroll"
	quest.4F2AF3CC87A16DDE.quest_desc: [
		"\"Play\" on the Mini-game Controller (or \"Test\" in the page editor): everyone within 5 blocks of a linked pipe plays, out of a party."
		"Results show what each place would earn; nothing is paid, everyone comes back."
	]
	quest.4F2AF3CC87A16DDE.title: "Test run"
	quest.4F7FD0FED1B42870.quest_desc: [
		"Placed against a solid block, a pipe is fixed to it (one block per pipe). The Wrench changes which one, down to none."
	]
	quest.4F7FD0FED1B42870.title: "Pipe fittings"
	quest.4FFDA1440AD648B3.quest_desc: [
		"Brewing stand: awkward potion + any star fragment gives a Potion of Luck (Luck I, 5:00), the only survival recipe for it."
	]
	quest.4FFDA1440AD648B3.title: "Potion of Luck"
	quest.51391531ACB06CD3.quest_desc: [
		"Fed to 40, the Mula swells and bursts: 64 star fragments of its colour (black: 1). It flies off as a shooting star and is reborn 100 to 400 blocks away."
	]
	quest.51391531ACB06CD3.title: "Pop!"
	quest.5146A65C1CB8AC6A.quest_desc: [
		"Shoot or throw from inside a bubble (arrow, snowball, potion...): a sparkly trail, and the creature hit gets a bubble of its own."
	]
	quest.5146A65C1CB8AC6A.title: "Bubbled!"
	quest.51CDCA2A7EA71CA8.quest_desc: [
		"Brush in hand: chevrons along the links, step numbers, \"?\" on forks, \"!\" on dead ends."
		"Wrench on a Party Controller (or /steveparty board check): every problem of the board."
	]
	quest.51CDCA2A7EA71CA8.title: "Board view and check"
	quest.51F269AB8B964D99.quest_desc: [
		"A cross of 5 planks: 2 panels. Stencil + axe cut the board along the pattern: a silhouette."
	]
	quest.51F269AB8B964D99.quest_subtitle: "Craft it (owned ones don't count)"
	quest.51F269AB8B964D99.title: "Cut-Out Wooden Panel"
	quest.52B016C6225E8428.quest_desc: [
		"Stamp a board tile: it takes the dye's colour, the pattern darker (with a cartridge inside, the cartridge keeps the look). A wet sponge wipes it."
	]
	quest.52B016C6225E8428.title: "Stamp a tile"
	quest.5322A5CC09B4DADC.quest_desc: [
		"Two carpets over two barrels (the carpets colour the awning)."
		"One column per offer, 9 at most: the goods on top, prices 1 and 2 below. The goods are a model: the sale takes them from the linked chests."
	]
	quest.5322A5CC09B4DADC.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5322A5CC09B4DADC.title: "Trading Stall"
	quest.5392461055ABAF56.quest_desc: [
		"Iron ingots, a smooth stone slab and an iron block. Insert a stencil and open the editor: left-click cuts a pixel, right-click fills it."
		"Your library keeps 128 patterns and learns those you carry."
	]
	quest.5392461055ABAF56.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5392461055ABAF56.title: "Stencil Maker"
	quest.540F65F4778F3FD7.quest_desc: [
		"Blue concrete, stone pressure plate, clock, iron and redstone."
		"Give it a Cartridge whose destinations are blocks: jump on it and they vanish, appear or toggle for a while (clock: the time). Plastic toggles by default."
	]
	quest.540F65F4778F3FD7.quest_subtitle: "Craft it (owned ones don't count)"
	quest.540F65F4778F3FD7.title: "Hop Switch"
	quest.54F196A1821033FE.quest_desc: [
		"Very rarely, a violent knock sends its cap flying; without it, the Slackorn turns shy. Wear the cap, or right-click its owner with it to give it back."
	]
	quest.54F196A1821033FE.title: "Acorn Hat"
	quest.55428C54977D8D69.quest_desc: [
		"The Wrench breaks any plastic block in one hit, even under water. Shears are fast too."
	]
	quest.55428C54977D8D69.title: "Quick clean-up"
	quest.55DCC18B70E655E2.quest_desc: [
		"The page's Results tab lists what ends the mini-game: linked podiums, goal pole bases and Party Rewinders."
		"A podium set with the Wrench can register the nearest player, or reset the group, on a pulse."
	]
	quest.55DCC18B70E655E2.title: "Results"
	quest.564863446D9C8AC2.quest_desc: [
		"Pawns on start spaces, then \"Start the party\" (or a redstone pulse). Everyone rolls for the order; each round is one turn per pawn and a mini-game."
		"Most Party Stars wins, then most Coins."
	]
	quest.564863446D9C8AC2.title: "Let's party!"
	quest.56D37AB8E45CB7CF.quest_desc: [
		"Coin + stone pressure plate + string. On your turn, before rolling, right-click: it sits on your pawn's space."
		"Blank, it steals 10 Coins. Sneak + right-click: choose its effect (Coins, steps back, a lost turn, an item) and sign it."
		"Another player's pawn that stops there springs it, for you."
	]
	quest.56D37AB8E45CB7CF.quest_subtitle: "Craft it (owned ones don't count)"
	quest.56D37AB8E45CB7CF.title: "Trap"
	quest.5738F405CD1ABF02.quest_desc: [
		"Bricks, sculk sensor, iron and redstone. It counts the points of the poles stacked on it. Set it with the Wrench."
	]
	quest.5738F405CD1ABF02.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5738F405CD1ABF02.title: "Goal Pole Base"
	quest.57714CCCE52A3BB1.quest_desc: [
		"One plastic block gives 4 studs of its colour (4 studs in a square give the block back). A small piece on floor, wall or ceiling that needs no support."
	]
	quest.57714CCCE52A3BB1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.57714CCCE52A3BB1.title: "Blue Plastic Stud"
	quest.57CE1899FD49EB32.quest_desc: [
		"A spyglass on a copper ingot, over 3 sticks."
		"At night, clear sky: the scroll wheel replays past shooting-star nights within 1000 blocks. Keep a star in the sights: a guide star lights up above the Mulas."
	]
	quest.57CE1899FD49EB32.quest_subtitle: "Craft it (owned ones don't count)"
	quest.57CE1899FD49EB32.title: "Telescope"
	quest.5806AB33C242D3BE.quest_desc: [
		"Leather, planks, a stencil and a stick. Loads 9 stencils and 9 dyes (sneak + right-click)."
		"Sneak + scroll: stencil or colour (G switches). Right-click stamps signs, walls, tiles and podiums."
	]
	quest.5806AB33C242D3BE.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5806AB33C242D3BE.title: "Stencil Hammer"
	quest.58AD4044E1C5BEBD.quest_desc: [
		"4 identical stones (stone, granite, deepslate, sandstone...): 1 engraved stone. The stencil really digs the pattern; side by side, their tops merge into one lintel."
	]
	quest.58AD4044E1C5BEBD.quest_subtitle: "Craft it (owned ones don't count)"
	quest.58AD4044E1C5BEBD.title: "Rock Sign"
	quest.597CC5EE9AFD84E4.quest_desc: [
		"Leather + glowstone dust + copper ingot."
		"Lamp on (G): the whole board, the nearby spaces in detail, the exact numbers of the one you look at."
	]
	quest.597CC5EE9AFD84E4.quest_subtitle: "Craft it (owned ones don't count)"
	quest.597CC5EE9AFD84E4.title: "Explorer's Helmet"
	quest.598F31A259B60ADB.quest_desc: [
		"Both families in every shape, and checkerboard tiles."
	]
	quest.598F31A259B60ADB.title: "Master builder"
	quest.59BCFCAF6BA910B4.quest_desc: [
		"6 iron ingots, a Party Star and the copper mini-game pipe. Reaches the whole dimension."
	]
	quest.59BCFCAF6BA910B4.quest_subtitle: "Craft it (owned ones don't count)"
	quest.59BCFCAF6BA910B4.title: "Iron Mini-game Pipe"
	quest.5A1C048043D2611F.quest_desc: [
		"A glass block over a Bubbler."
		"It shows where the creature of a space appears and where it faces: link it with the Tile Linker Brush, from the space to the bubble."
		"Wrench: \"Always visible\" and height. Sneak + Wrench: turn it."
	]
	quest.5A1C048043D2611F.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5A1C048043D2611F.title: "Spawn Bubble"
	quest.5A220F1629768E53.quest_desc: [
		"Raw cod or salmon, one at a time: 6 to 10 of them."
		"Tamed, it follows you, gives you Luck within 16 blocks, and monsters near it miss one hit in three. Empty hand: sit or stand."
	]
	quest.5A220F1629768E53.title: "A lucky cat"
	quest.5A7CE62676D0F450.quest_desc: [
		"A Podium + a gold ingot, shapeless. Only a look: the height of the column decides the place."
	]
	quest.5A7CE62676D0F450.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5A7CE62676D0F450.title: "Gold Podium"
	quest.5B4767F40E06F23E.quest_desc: [
		"Mix star fragments like dyes: black + white. You get back as many fragments as you put in."
	]
	quest.5B4767F40E06F23E.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5B4767F40E06F23E.title: "Gray Star Fragment"
	quest.5B628A39A4C798B1.quest_desc: [
		"The same with two polished concrete colours. Every pair of colours works; the item keeps its colours in its name."
	]
	quest.5B628A39A4C798B1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5B628A39A4C798B1.title: "Polished Concrete Tiles"
	quest.5C4295392DE2E5D1.quest_desc: [
		"6 copper ingots around a paper. Click it with a page: the entrance to that mini-game out of a party, within 100 blocks."
		"Coloured pipes linked to it send each player to their role."
	]
	quest.5C4295392DE2E5D1.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5C4295392DE2E5D1.title: "Copper Mini-game Pipe"
	quest.5C6EDA264FC2653D.quest_desc: [
		"6 blocks in steps: 4 stairs."
	]
	quest.5C6EDA264FC2653D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5C6EDA264FC2653D.title: "Polished Orange Terracotta Stairs"
	quest.5DA080B1E3CBDCA8.quest_desc: [
		"6 plastic blocks of the colour in two columns: 6 pipes. Linked to a page, a pipe of this colour has the role \"Players\"."
	]
	quest.5DA080B1E3CBDCA8.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5DA080B1E3CBDCA8.title: "Green Pipe: Players"
	quest.5DD0CA51D02BCCC0.quest_desc: [
		"A stick, a slime ball and a bowl. Right-click a mob to mute it; again to give its voice back."
	]
	quest.5DD0CA51D02BCCC0.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5DD0CA51D02BCCC0.title: "Plunger"
	quest.5DF43B3F6C9F0DC0.quest_desc: [
		"A wild Wickling steals a shiny item from a player within 2 blocks and runs off giggling, sometimes to drop it at another player's feet."
		"A torch or lantern in hand protects you. Melee does nothing; projectiles do."
	]
	quest.5DF43B3F6C9F0DC0.title: "Stop, thief!"
	quest.5E174C6DCB411FC0.quest_desc: [
		"Dropped by a black Mula when it bursts (only one, and black Mulas are rare)."
	]
	quest.5E174C6DCB411FC0.title: "Black Star Fragment"
	quest.5E38267B9B2C3CF9.quest_desc: [
		"4 light blue concrete in a square: 4 polished blocks (17 colours for terracotta, 16 for concrete). The stonecutter makes every shape from the vanilla block directly."
	]
	quest.5E38267B9B2C3CF9.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5E38267B9B2C3CF9.title: "Polished Light Blue Concrete"
	quest.5E498DCFAA8D5873.quest_desc: [
		"Hold any seeds: magpies within 10 blocks stop fleeing, come to you in little hops and follow you. Chicks too."
	]
	quest.5E498DCFAA8D5873.title: "Seed charmer"
	quest.5E623F55BBE37FE9.quest_desc: [
		"Shears again on a trader without its bandana: you steal the look of its box."
		"Wear it as a chestplate; sneak and stand still 2 s: you become a real block."
	]
	quest.5E623F55BBE37FE9.title: "Box Costume"
	quest.5EC05D8B076F3374.quest_desc: [
		"Quests are shared per FTB Teams team. To share progress with friends, create a party with /ftbteams party create and invite them."
		"Rewards stay personal: everyone claims their own."
	]
	quest.5EC05D8B076F3374.title: "Party up"
	quest.5F62DDBD464BC0DA.quest_desc: [
		"6 bricks in steps: 4 stairs."
	]
	quest.5F62DDBD464BC0DA.quest_subtitle: "Craft it (owned ones don't count)"
	quest.5F62DDBD464BC0DA.title: "Polished Light Blue Concrete Brick Stairs"
	quest.5FECE4CA8D043161.quest_desc: [
		"Trader, stall, a stock chest and a register, all linked with the key; an offer on the stall, stock in the chest."
		"Customers right-click the trader: offers as cards (red: can't pay, crossed out: sold out). The owner's shop is protected."
	]
	quest.5FECE4CA8D043161.title: "Open for business"
	quest.609D01D79D635986.quest_desc: [
		"5 gold nuggets. Candle holder + saucer: it sits on its saucer. Alone in the grid, it comes off again."
	]
	quest.609D01D79D635986.quest_subtitle: "Craft it (owned ones don't count)"
	quest.609D01D79D635986.title: "Candle Saucer"
	quest.60C92A51C5BD85F6.quest_desc: [
		"Plant an acorn on farmland: it grows in 4 stages like a crop, then hatches by itself into a sleeping young Slackorn. Bone meal speeds it up."
	]
	quest.60C92A51C5BD85F6.title: "Plant an acorn"
	quest.615172E117B614F4.quest_desc: [
		"Gold ingot + amethyst shard. Opens a Key Gate once. An item like any other: sell it, give it as a prize, hide it in a Tricauldron."
	]
	quest.615172E117B614F4.quest_subtitle: "Craft it (owned ones don't count)"
	quest.615172E117B614F4.title: "Gate Key"
	quest.61DD313CE6A35BC2.quest_desc: [
		"Draw your own 16x16 pattern on the grid (flip, rotate, invert, undo...) and save it on the stencil."
	]
	quest.61DD313CE6A35BC2.title: "Cut a pattern"
	quest.620A5C7BA9429AD1.quest_desc: [
		"Tiles, checkpoints, the main cartridges and a closed loop: your board is ready for pawns."
	]
	quest.620A5C7BA9429AD1.title: "Board builder"
	quest.6305DEBDCAB9BBA0.quest_desc: [
		"A Blank Die Module ringed with 7 light blue star fragments, a clock on top."
		"The die spins slowly; its roller hits it to stop on the face shown."
	]
	quest.6305DEBDCAB9BBA0.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6305DEBDCAB9BBA0.title: "Die Module: Slow"
	quest.639372715E2D9036.quest_desc: [
		"Two Teleport spaces of the same colour on one board. A dye on the space changes its network; a lone colour sends nobody anywhere."
	]
	quest.639372715E2D9036.title: "A teleport network"
	quest.63E7493B3F8C4B36.quest_desc: [
		"6 plastic blocks of the colour in two columns: 6 pipes. Linked to a page, a pipe of this colour has the role \"Spectators\"."
	]
	quest.63E7493B3F8C4B36.quest_subtitle: "Craft it (owned ones don't count)"
	quest.63E7493B3F8C4B36.title: "White Pipe: Spectators"
	quest.653CF6E9C6766795.quest_desc: [
		"4 plastic blocks and 2 glass: 6 windowed pipes, with a continuous window along the tube."
	]
	quest.653CF6E9C6766795.quest_subtitle: "Craft it (owned ones don't count)"
	quest.653CF6E9C6766795.title: "Cyan Windowed Pipe"
	quest.65FD4DC5FA855317.quest_desc: [
		"Roll near your pawn on a linked board: it walks the result. At a fork, right-click an arrow empty-handed."
	]
	quest.65FD4DC5FA855317.title: "Move a pawn"
	quest.67A3F4DF1F5ABD68.quest_desc: [
		"Cartridge + acorn. A tower of Slackorns pushes the pawn that stops here along the path (menu: distance, height), with every pawn it meets."
		"Each pawn met knocks one Slackorn off; none left, the tower stops."
	]
	quest.67A3F4DF1F5ABD68.quest_subtitle: "Craft it (owned ones don't count)"
	quest.67A3F4DF1F5ABD68.title: "Slackorn Cartridge"
	quest.680DFFB134E7498D.quest_desc: [
		"2 iron ingots + 2 nether quartz: 4 Blank Die Faces. Every face starts blank (stonecutter); the Dice Forge uses them up."
	]
	quest.680DFFB134E7498D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.680DFFB134E7498D.title: "Blank Die Face"
	quest.68FDB8B9B18F5221.quest_desc: [
		"Redstone + iron ingot."
		"Right-click opens tiles, Checkpoints and routers. A cartridge in the off hand swaps the tile's own, links kept."
		"It also sets podiums, poles and Spawn Bubbles, and breaks plastic in one hit."
	]
	quest.68FDB8B9B18F5221.quest_subtitle: "Craft it (owned ones don't count)"
	quest.68FDB8B9B18F5221.title: "Wrench"
	quest.69316CAE3341B411.quest_desc: [
		"Right-click in the air with the cartridge: up to 12 sentences."
		"Each one: a kind (Theft, Redistribute, Move back, Cursed die, Pity), a target (who lands here, 1st, last, richest, everyone...), a number and a weight."
		"Nothing is created: thefts go to the party's storage, pity comes out of it."
	]
	quest.69316CAE3341B411.title: "Write the sentences"
	quest.69911E8F52BE5816.quest_desc: [
		"At night, Mulas on a lead can lift you up like balloons: one big Mula, two half-full ones or three of any size. You land softly at dawn."
	]
	quest.69911E8F52BE5816.title: "Up, up and away"
	quest.6A47B29FC1D81DDA.quest_desc: [
		"Premium faces (1 to 10) shine in gold on the die. For now they count like normal numbers."
	]
	quest.6A47B29FC1D81DDA.title: "Premium Die Face 10"
	quest.6AD835CCA129C2DD.quest_desc: [
		"4 plastic pellets + 1 dye: 4 blocks of its colour. 8 blocks around a dye: recoloured."
		"Neighbours of the same colour merge into one piece (up to 4x2x4)."
	]
	quest.6AD835CCA129C2DD.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6AD835CCA129C2DD.title: "Red Plastic Block"
	quest.6B5FF43F4D5E73E2.quest_desc: [
		"5 plastic pellets + chest. Right-click your pawn with an empty Token to store it, right-click a block to put it back: how a pawn moves by hand."
	]
	quest.6B5FF43F4D5E73E2.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6B5FF43F4D5E73E2.title: "Token"
	quest.6C63BD50698F0417.quest_desc: [
		"Two rows of 3: 6 walls."
	]
	quest.6C63BD50698F0417.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6C63BD50698F0417.title: "Polished Light Blue Concrete Brick Wall"
	quest.6D8D21CED52BF7F8.quest_desc: [
		"Mix star fragments like dyes: blue + green. You get back as many fragments as you put in."
	]
	quest.6D8D21CED52BF7F8.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6D8D21CED52BF7F8.title: "Cyan Star Fragment"
	quest.6E17301AB8D3AB20.quest_desc: [
		"Seeds to two wild magpies within 8 blocks of each other: a chick hatches, of one parent's colour."
		"In a nest it sits and sleeps there; it grows up in 20 minutes (seeds speed it up)."
	]
	quest.6E17301AB8D3AB20.title: "A chick!"
	quest.6E22696E6BCB0E7C.quest_desc: [
		"Cursed faces (1 to 3) show a purple skull. For now they count like normal numbers."
	]
	quest.6E22696E6BCB0E7C.title: "Cursed Die Face 3"
	quest.6E614CCC831846DA.quest_desc: [
		"A Podium + a copper ingot, shapeless. Only a look: the height of the column decides the place."
	]
	quest.6E614CCC831846DA.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6E614CCC831846DA.title: "Copper Podium"
	quest.6EF85DD450A37FB8.quest_desc: [
		"Page in hand, click a pipe mouth to link it (again to unlink); linked pipes glow while you hold the page."
		"When the mini-game starts, each player comes out of a pipe of their role."
	]
	quest.6EF85DD450A37FB8.title: "Link the pipes"
	quest.6F216B6287815B35.quest_desc: [
		"Map, glass, redstone torch, gold ingots, chest and iron ingots."
		"The heart of a party: turns, mini-games and prizes."
	]
	quest.6F216B6287815B35.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6F216B6287815B35.title: "Party Controller"
	quest.6FC6A979673D9964.quest_desc: [
		"Mix star fragments like dyes: purple + pink. You get back as many fragments as you put in."
	]
	quest.6FC6A979673D9964.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6FC6A979673D9964.title: "Magenta Star Fragment"
	quest.6FE0D77A51E3FB74.quest_desc: [
		"6 blocks in steps: 4 stairs. Aligned shapes of the same colour connect their textures too."
	]
	quest.6FE0D77A51E3FB74.quest_subtitle: "Craft it (owned ones don't count)"
	quest.6FE0D77A51E3FB74.title: "Green Plastic Stairs"
	quest.7025AE0D120A1991.quest_desc: [
		"Plastic in still water rises to the surface, carrying what stands on it. Over soul sand, a bubble column is an elevator; over magma, down. A chain anchors it."
	]
	quest.7025AE0D120A1991.title: "It floats!"
	quest.71053C5ABE278389.quest_desc: [
		"By day, a magpie picks up a shiny item lying within 12 blocks (gold, iron, diamond, emerald, Coins...) and carries it to its nest. At night it sleeps in a free nest."
	]
	quest.71053C5ABE278389.title: "Thief of shiny things"
	quest.712A530A271BB07F.quest_desc: [
		"Ridden, steered, merged, and placed on the board."
	]
	quest.712A530A271BB07F.title: "Bubble blower"
	quest.71B10B23BE563B45.quest_desc: [
		"A thief tamed into a lamp, and a robbery on the board."
	]
	quest.71B10B23BE563B45.title: "Candlelight"
	quest.71C9296D907886EF.quest_desc: [
		"Dodged, drained, tamed, ridden, and put on the board."
	]
	quest.71C9296D907886EF.title: "Lava rider"
	quest.71CC2E37EF714902.quest_desc: [
		"2 redstone + 2 paper + 2 plastic pellets."
		"A cartridge gives a tile its role. This plain one has none: just a path. Every other cartridge is this one + an ingredient."
		"Right-click in the air: its menu."
	]
	quest.71CC2E37EF714902.quest_subtitle: "Craft it (owned ones don't count)"
	quest.71CC2E37EF714902.title: "Cartridge"
	quest.722DDCFD99F1743D.quest_desc: [
		"Blank face + spider eye: a -1 Debt face (stonecutter: -2 to -10). The roller pays that many Coins to the storage, never more than they have."
	]
	quest.722DDCFD99F1743D.quest_subtitle: "Craft it (owned ones don't count)"
	quest.722DDCFD99F1743D.title: "Debt Die Face −1"
	quest.734C85BCB3D708BB.quest_desc: [
		"4 iron nuggets around a paper: 2 blank stencils. Structure chests may hold one of 50 built-in patterns. A cut stencil + blank ones: copies."
	]
	quest.734C85BCB3D708BB.quest_subtitle: "Craft it (owned ones don't count)"
	quest.734C85BCB3D708BB.title: "Stencil"
	quest.736773478A5996A7.quest_desc: [
		"Cartridge + repeater. The player whose pawn stops here rolls again at once, with their die back. One extra turn only."
	]
	quest.736773478A5996A7.quest_subtitle: "Craft it (owned ones don't count)"
	quest.736773478A5996A7.title: "Roll Again Cartridge"
	quest.73EEF7997DCDB74C.quest_desc: [
		"A magpie moves onto the linked nest. Each pawn passing the space stakes Coins (1 by default), the magpie fetches them; the pawn that stops there wins the whole nest."
		"Menu: stake, base (from the space's storage or the Party Controller's, never created) and cap."
	]
	quest.73EEF7997DCDB74C.title: "The Common Pot"
	quest.7474041B576499AF.quest_desc: [
		"Smelt sugar cane. Pellets go into almost everything: tiles, cartridges, Tokens, plastic blocks."
	]
	quest.7474041B576499AF.quest_subtitle: "Click the task to hand them in"
	quest.7474041B576499AF.title: "Plastic Pellets"
	quest.74A69E19FF0BCA86.quest_desc: [
		"3 bricks in a row: 6 slabs."
	]
	quest.74A69E19FF0BCA86.quest_subtitle: "Craft it (owned ones don't count)"
	quest.74A69E19FF0BCA86.title: "Polished Light Blue Concrete Brick Slab"
	quest.75D850169554760C.quest_desc: [
		"Paint back to the first tile: a loop with a Start space is all a party needs."
		"Several links from a tile: a fork, the player chooses. No link: a dead end."
	]
	quest.75D850169554760C.title: "Close the loop"
	quest.778C3F69BBD69981.quest_desc: [
		"Two rows of 3: 6 walls."
	]
	quest.778C3F69BBD69981.quest_subtitle: "Craft it (owned ones don't count)"
	quest.778C3F69BBD69981.title: "Polished Light Blue Concrete Wall"
	quest.77D47E2D75956F53.quest_desc: [
		"4 gold ingots, an eye of ender, 2 Party Stars and the iron mini-game pipe. Reaches every dimension."
	]
	quest.77D47E2D75956F53.quest_subtitle: "Craft it (owned ones don't count)"
	quest.77D47E2D75956F53.title: "Golden Mini-game Pipe"
	quest.77FE553DBC59E8E9.quest_desc: [
		"Three wool: the flag takes their colour (mixed like leather). Right-click a segment to hang it; it slides down when the goal is reached."
	]
	quest.77FE553DBC59E8E9.quest_subtitle: "Craft it (owned ones don't count)"
	quest.77FE553DBC59E8E9.title: "Flag"
	quest.78060E8B8175066C.quest_desc: [
		"A Blank Die Module ringed with 7 blue star fragments, a compass on top."
		"The roller picks the face."
	]
	quest.78060E8B8175066C.quest_subtitle: "Craft it (owned ones don't count)"
	quest.78060E8B8175066C.title: "Die Module: Choice"
	quest.785AA345B1B2CC7F.quest_desc: [
		"A Blank Die Module ringed with 7 green star fragments, a rabbit's foot on top."
		"One extra roll per module (up to 5): keep the best one."
	]
	quest.785AA345B1B2CC7F.quest_subtitle: "Craft it (owned ones don't count)"
	quest.785AA345B1B2CC7F.title: "Die Module: Lucky"
	quest.78C9F801227DBCA8.quest_desc: [
		"Cartridge + red dye. A pawn reaching it stops there, whatever steps it has left. Works on a Checkpoint too."
	]
	quest.78C9F801227DBCA8.quest_subtitle: "Craft it (owned ones don't count)"
	quest.78C9F801227DBCA8.title: "Stop Cartridge"
	quest.79E5CE07E2521CF7.quest_desc: [
		"Shears on an open trader wearing its bandana: it falls, the trader hides for 20 s."
		"Wear it: traders ignore you. Give one to a bald trader to change its colour."
	]
	quest.79E5CE07E2521CF7.title: "Bandana"
	quest.79EBF22157E78E6D.quest_desc: [
		"The core climbs with the fragments in the forge: 320 (5 full stacks, or 5 black ones worth 64 each) lift it 16 blocks."
		"Max level: an Ephemeride every full moon."
	]
	quest.79EBF22157E78E6D.title: "Highest orbit"
	quest.7A67F524EE372745.quest_desc: [
		"In a party, a pawn stopping on a Shop space brings out its own Boxed Trader. Right-click it (or [Open the shop] in the chat) and buy, up to the cartridge's limit (1 by default)."
		"Payments go to the Party Controller's storage."
	]
	quest.7A67F524EE372745.title: "Shop stop"
	quest.7B61B7E9D8BEF2E8.quest_desc: [
		"Two plastic blocks (any colour) on top of each other: 4 sticks. The plastic fences are made of them."
	]
	quest.7B61B7E9D8BEF2E8.quest_subtitle: "Craft it (owned ones don't count)"
	quest.7B61B7E9D8BEF2E8.title: "Plastic Stick"
	quest.7CD8704D1E8BE3C5.quest_desc: [
		"A blue plastic stud + paper + redstone: 4 cards."
		"Every pawn plays once."
		"Program tab: 24 slots, read left to right."
	]
	quest.7CD8704D1E8BE3C5.quest_subtitle: "Craft it (owned ones don't count)"
	quest.7CD8704D1E8BE3C5.title: "Party Card: Turns"
	quest.7CE9B67A9BE1ED07.quest_desc: [
		"A Mula only eats food of its colour (the tooltip says \"Mula food\"):"
		"blue: cod · red: apples, berries, salmon, raw meat · green: melon · yellow: golden food, bread, honey · purple: chorus, beetroot · black: dried kelp, cookies, stews, steak"
	]
	quest.7CE9B67A9BE1ED07.title: "Snack time"
	quest.7D674A4D41A2C9AB.quest_desc: [
		"Wrench on a segment: the pole lights up when the total reaches (or equals, or stays under) a value."
		"\"Goal: per player\": each player who reaches it gets the highest free podium place."
	]
	quest.7D674A4D41A2C9AB.title: "Set a goal"
	quest.7D6CB020DBA7A8FC.quest_desc: [
		"Right-click in the air with the page: the editor. A title, a description (400 characters, with colours) and an image (drop a PNG or JPEG on the window), shown when the mini-game is drawn."
	]
	quest.7D6CB020DBA7A8FC.title: "Write the page"
	quest.7DADEB95247215E8.quest_desc: [
		"A special face: the pawn stays where it is and the space under it triggers again."
	]
	quest.7DADEB95247215E8.title: "Die Face 0"
	quest.7E305E47E151BDCF.quest_desc: [
		"Two rows of 3 blocks: 6 walls."
	]
	quest.7E305E47E151BDCF.quest_subtitle: "Craft it (owned ones don't count)"
	quest.7E305E47E151BDCF.title: "Purple Plastic Wall"
	quest.7E41138FB7521482.quest_desc: [
		"Rolls 1 to 10. The first two come with the Tile quest; more come out of the Dice Forge."
	]
	quest.7E41138FB7521482.title: "Simple Die"
	quest.7F2770DE1C7C8D45.quest_desc: [
		"Cartridge + ender pearl. A pawn stopping here goes to another Teleport space of the same colour (purple, green, orange or blue)."
	]
	quest.7F2770DE1C7C8D45.quest_subtitle: "Craft it (owned ones don't count)"
	quest.7F2770DE1C7C8D45.title: "Teleport Cartridge"
	quest.7F5DEAD5FEF3AA2C.quest_desc: [
		"Flint and steel on a wild Wickling: the first strike makes it give back its loot, then 1 chance in 3 per strike to tame it."
		"Tamed, it follows you as a lamp. Flint and steel heals it."
	]
	quest.7F5DEAD5FEF3AA2C.title: "Rekindle the flame"
	quest.7FA9DC98F4753074.quest_desc: [
		"Right-click the forge with the Gravity Core: it sinks in, then floats above. Sneak + right-click empty-handed: take it back."
		"Hit the floating core and it explodes (lost)."
	]
	quest.7FA9DC98F4753074.title: "Ignite the forge"
	quest.7FEC43F982FF3CC8.quest_desc: [
		"Cartridge + iron bars. A wall: a pawn with steps left only goes through if its roll meets the condition (7 or more by default, a double, a triple...). Otherwise it stops here."
		"Barrier mode: a new try every turn."
	]
	quest.7FEC43F982FF3CC8.quest_subtitle: "Craft it (owned ones don't count)"
	quest.7FEC43F982FF3CC8.title: "Threshold Obstacle Cartridge"
	reward_table.1FEF45914C419791.title: "Party Favors"
	reward_table.536A6CC3E21C8B88.title: "Star Chest"
}
